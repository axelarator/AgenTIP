# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
build/
dist/
.pytest_cache/

# Local cluster data. Threat intel tracked here is often sensitive/
# org-specific, so it's not committed by default — fork this repo or
# point CTI_DATA_DIR at a separate (possibly private) data repo if you
# want cluster JSON under version control.
data/clusters/*
!data/clusters/.gitkeep

# Queue of infra awaiting active JA4+/JARM fingerprinting - transient
# work state, not tracked intel.
data/pending_fingerprints.json

# Actor-tracking time-series layer (DuckDB store, report inbox/archive,
# daily digests/narratives, cron logs) - same sensitivity rationale as
# data/clusters/ above.
data/tracking/*
!data/tracking/.gitkeep

# Secrets - API keys (WEBAMON_API_KEY etc.) live in the shell environment
# (~/.bashrc, sourced by cron), never committed.
.env

# Harness-local state
.claude/settings.local.json

# Generated skill mirrors - skills/ is canonical, setup.sh copies it into
# the per-harness locations. Committing all three made them drift.
.claude/skills/
.pi/skills/

# LangGraph run traces (one JSONL per run) - runtime state, not intel.
data/runs/

# Frontend build tooling. The built bundle in dashboard/static/ IS committed
# (the lab VM serves it directly and nothing on that path has node), but the
# dependency tree that produces it is not.
dashboard/ui/node_modules/
dashboard/ui/.vite/

# Stale nested copy left by the 2026-09-19 migration - holds the same
# sensitive cluster/tracking data as above, just one level deeper.
data/data/
