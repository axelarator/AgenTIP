{
  "mcpServers": {
    "cti-tools": {
      "transport": "stdio",
      "command": "/home/agent/cti-agent/mcp-server/.venv/bin/python",
      "args": ["-m", "cti_tools.server"],
      "cwd": "/home/agent/cti-agent/mcp-server",
      "env": {"VT_API_KEY": "${VT_API_KEY}",
              "HONEYLABS_API_KEY": "${HONEYLABS_API_KEY}",
              "THREATFOX_API_KEY": "${THREATFOX_API_KEY}"},
      "lifecycle": "lazy"
    }
  }
}
